# ============================================================
# Local Knowledge Graph notebook (offline 6.4.10) — пример конфига
# Скопируйте в .env и подправьте под себя.
# ============================================================

# ── Источник данных ─────────────────────────────────
PM_SOURCE_MODE=sqlite            # sqlite | csv
PM_SQLITE=pm_knowledge_local.sqlite
PM_CSV_DIR=.
# PM_DATA_DIR=.

# ── Векторизация: два бэкенда ────────────────────────
PM_EMBED_BACKEND=local           # local | openai
PM_EMBED_BATCH=64

# --- backend=local (SentenceTransformer, офлайн, без ключей) ---
PM_LOCAL_EMBED_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# --- backend=openai (OpenAI-совместимый /embeddings, как в проде) ---
PM_EMBED_BASE=https://foundation-models.api.cloud.ru/v1
PM_EMBED_KEY=
PM_EMBED_MODEL=Qwen/Qwen3-VL-Embedding-8B
PM_EMBED_DIM=4096                # 0 = автодетект по первому ответу API
PM_EMBED_TIMEOUT=60

# ── Саммари (опционально, OpenAI-совместимый LLM) ─────────
PM_LLM_BASE_URL=
PM_LLM_API_KEY=
PM_LLM_MODEL=anthropic/claude-haiku-4.5
