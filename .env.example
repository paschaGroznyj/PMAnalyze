# LLM (cloud.ru)
CLOUD_LLM_ACCESS_KEY=
CLOUD_LLM_BASE=https://foundation-models.api.cloud.ru/v1
PM_SUMMARY_MODEL=anthropic/claude-haiku-4.5
ARTICLE_RELEVANCE_MODEL=anthropic/claude-sonnet-4.6
ARTICLE_REVIEW_MODEL=anthropic/claude-sonnet-4.6

# Embeddings (OpenAI-совместимый клиент; по умолчанию фолбэк на CLOUD_LLM_*)
PM_EMBED_MODEL=Qwen/Qwen3-VL-Embedding-8B
PM_EMBED_DIM=4096
PM_EMBED_BASE=https://foundation-models.api.cloud.ru/v1
PM_EMBED_KEY=

# DB
PMANALYZE_DSN=postgresql://catchpm:catchpm2026@catchpm-postgres:5432/catchpm_chat

# Parser service (catchpm-browser)
PARSER_SERVICE_URL=http://catchpm-browser:9333/api/parser/run
PARSER_PDF_URL=http://catchpm-browser:9333/api/pdf/fulltext
PARSER_SERVICE_API_KEY=
PARSER_SERVICE_TIMEOUT_SECONDS=180

# S3 / OBS
OBS_BUCKET=
OBS_OPEN_BUCKET=
OBS_ACCESS_KEY=
OBS_SECRET_KEY=
OBS_REGION=ru-moscow
OBS_ENDPOINT=https://obs.ru-moscow-1.hc.sbercloud.ru
